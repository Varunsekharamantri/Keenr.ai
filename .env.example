# Copy to .env and fill in. .env is gitignored and must never be committed.
# In GitHub Actions these are supplied as repository Secrets instead.

PROJECT_NAME=Market Signals Platform
VERSION=1.0.0

# --- Database -------------------------------------------------------------
# Local default is SQLite. For Neon Postgres use the pooled connection string:
#   postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL=

# --- SEC EDGAR (free, no key; a contact User-Agent is required by the SEC) --
SEC_USER_AGENT=YourAppName your.email@example.com
SEC_RATE_LIMIT_DELAY=0.2

# --- Scheduler ------------------------------------------------------------
# Set SCHEDULE_ENABLED=false once GitHub Actions runs the nightly ingest,
# otherwise the app and the Action will both ingest.
SCHEDULE_ENABLED=true
SCHEDULE_INTERVAL_HOURS=24
SCHEDULE_LIMIT_PER_COMPANY=3
SCHEDULE_RUN_ON_STARTUP=false
SCHEDULE_SECTOR_FILTER=BFSI

# --- LLM enrichment (optional; rule-based extractor works without it) ------
Groq_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
# Fallbacks when Groq cannot answer (daily budget spent, rate limit, error).
# Optional; tried in this order after Groq. See backend/app/ai/providers.py.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=

# --- Exa neural search ----------------------------------------------------
# Free tier is ~1428 requests/month; budgets are enforced before each call.
Exa_API_key=
EXA_MAX_CHARACTERS=2000
EXA_MONTHLY_BUDGET=700

# --- Optional integrations (inert when unset) -----------------------------
SLACK_WEBHOOK_URL=
CRM_WEBHOOK_URL=
SAMGOV_API_KEY=
PATENTSVIEW_API_KEY=

# Set false on ephemeral cloud runners — the raw text archive is write-only.
RAW_STORE_ENABLED=true
